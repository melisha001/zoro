# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zoro_academy
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Security (Must be a Base64-encoded key of at least 32 bytes / 256 bits)
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_here
JWT_EXPIRATION=86400000

# Bunny Stream Video Storage & Streaming
BUNNY_LIBRARY_ID=your_bunny_library_id_here
BUNNY_API_KEY=your_bunny_stream_api_key_here
BUNNY_CDN_HOST=your_pullzone.b-cdn.net
BUNNY_TOKEN_AUTH_KEY=your_bunny_stream_token_auth_key_here
BUNNY_WEBHOOK_SECRET=your_bunny_webhook_secret_here

# Initial Administrator Credentials (Required for bootstrapping admin account)
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_secure_admin_password_here

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
