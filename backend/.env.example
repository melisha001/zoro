# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zoro_academy
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Security (Must be at least 64 hex characters / 256-bit key)
JWT_SECRET=your_secure_256_bit_jwt_secret_hex_string_here_rotate_regularly
JWT_EXPIRATION=86400000

# Bunny Stream Video Storage & Streaming
BUNNY_LIBRARY_ID=770045
BUNNY_API_KEY=your_bunny_stream_api_key_here
BUNNY_CDN_HOST=vz-251d06e3-32f.b-cdn.net
BUNNY_TOKEN_AUTH_KEY=your_bunny_stream_token_auth_key_here
BUNNY_WEBHOOK_SECRET=your_bunny_webhook_secret_here

# Initial Administrator Credentials (Required for startup/production)
ADMIN_EMAIL=admin@zoro.com
ADMIN_PASSWORD=your_secure_admin_password_here

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
